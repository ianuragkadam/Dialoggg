# Local server
PORT=3030

# SQLite directory. Railway production uses /data on a persistent volume.
RAILWAY_VOLUME_MOUNT_PATH=./data

# Private bearer tokens for the client questionnaire and internal review page.
# Generate long random values; never commit production tokens.
REQUIREMENTS_FORM_TOKEN=replace-with-a-long-random-token
REQUIREMENTS_REVIEW_TOKEN=replace-with-a-different-long-random-token

# Separate bearer tokens for the 19-question follow-up workshop and review page.
FOLLOW_UP_REQUIREMENTS_FORM_TOKEN=replace-with-a-third-long-random-token
FOLLOW_UP_REQUIREMENTS_REVIEW_TOKEN=replace-with-a-fourth-long-random-token

# Optional local reset seed. Use unique local values; the seed is blocked in production.
DIALOGGG_SEED_COMPANY=Your Local Company
DIALOGGG_SEED_ADMIN_NAME=Local Administrator
DIALOGGG_SEED_ADMIN_EMAIL=admin@example.test
DIALOGGG_SEED_ADMIN_PASSWORD=replace-with-a-unique-12-character-password
